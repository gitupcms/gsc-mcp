# Set at least one of ADMIN_TOKEN / MCP_AUTH_TOKEN. Generate with: openssl rand -hex 32
# Admin bearer for /admin/tokens (issue, list, rotate, revoke per-client tokens; `npm run token`). Unset = admin API off.
ADMIN_TOKEN=
# Lifetime of issued tokens in days when not given. Default 90, max 365.
# TOKEN_TTL_DAYS=90
# Legacy single shared bearer token; still accepted, logs a deprecation warning.
# MCP_AUTH_TOKEN=

# Google sign-in: set EITHER the three GOOGLE_OAUTH_* values OR a service-account key, not both.
# OAuth (your own account): run `npm run oauth:login` to get the refresh token. Set GSC_ALLOWED_SITES too.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=

# Path to the service-account JSON key. docker-compose sets this to the mounted secret.
# For local development: GOOGLE_APPLICATION_CREDENTIALS=./secrets/gsc-sa.json
# GOOGLE_APPLICATION_CREDENTIALS=
# Or pass the key JSON itself (used instead of the file when set). Never commit it.
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional. Comma-separated hostnames to accept in the Host header (DNS-rebinding protection), e.g. gsc-mcp.example.com.
# Bare hostnames only (no https:// or path); ports are ignored. Behind nginx, also set `proxy_set_header Host $host;`.
# ALLOWED_HOSTS=

# Optional. Comma-separated properties the bot may read. Default: every property the Google account can see (recommended with OAuth).
# GSC_ALLOWED_SITES=https://www.example.com/,sc-domain:example.org

# Fraction of Google's published limits to use locally (0-1). Default 0.8.
# QUOTA_SAFETY_FACTOR=0.8
# How long a call may wait for a free rate-limit slot before failing. Default 15000.
# MAX_QUEUE_WAIT_MS=15000
# Max parallel Google API calls. Default 4.
# MAX_CONCURRENCY=4
# Max rows one search_analytics_query call may return. Default 25000, max 50000. (fetchAll returns 5000 unless maxRows asks for more.)
# GSC_MAX_ROWS_PER_CALL=25000
# CACHE_ENABLED=true
# LOG_LEVEL=info
# PORT=3000
# HOST_PORT=3000

# Optional. Public origin for OAuth (claude.ai connectors) behind a reverse proxy, e.g. https://gsc-mcp.example.com (no path).
# Default: taken from the request. OAuth is on whenever ADMIN_TOKEN is set.
# PUBLIC_URL=
# Optional. Extra exact OAuth redirect URIs, comma-separated (claude.ai/claude.com callbacks and http://localhost|127.0.0.1 are always allowed).
# OAUTH_REDIRECT_URIS=

# Optional. Path of the MCP endpoint (default /mcp), e.g. /gsc-mcp when published under that path.
# MCP_PATH=/mcp

{
  "name": "gitupcms-gscmcp",
  "version": "0.1.0",
  "description": "Read-only Google Search Console MCP server (Streamable HTTP, Hono)",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "main": "dist/node/index.js",
  "bin": {
    "gitupcms-gscmcp": "dist/node/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/node/index.ts",
    "start": "node dist/node/index.js",
    "start:stdio": "node dist/node/index.js --stdio",
    "typecheck": "tsc --noEmit -p tsconfig.core.json && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:check": "wrangler deploy --dry-run --outdir .wrangler/dry",
    "token": "tsx scripts/token.ts",
    "oauth:login": "tsx scripts/oauth-login.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.9",
    "@modelcontextprotocol/sdk": "1.32.2",
    "hono": "4.13.19",
    "lru-cache": "11.5.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261117.1",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.164.0"
  }
}
